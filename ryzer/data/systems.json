    {"id": "gbc", "name": "Game Boy Color", "short": "GBC", "folders": ["gbc"], "extensions": [".gbc", ".gb", ".zip", ".7z"], "tier": "great", "color": "#C2185B", "note": "Full speed.", "commands": ["ra:gambatte", "ra:mgba"]},
    {"id": "gb", "name": "Game Boy", "short": "GB", "folders": ["gb"], "extensions": [".gb", ".zip", ".7z"], "tier": "great", "color": "#8BAC0F", "note": "Full speed.", "commands": ["ra:gambatte", "ra:mgba"]},
