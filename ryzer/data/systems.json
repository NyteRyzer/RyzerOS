{
  "_comment": "Ryzer OS system list. Copy this file to <RYZER_HOME>/systems.json to customise it. Each command is tried in order; the first whose program exists is used. 'ra:<core>' means RetroArch with that libretro core. {rom} is replaced with the quoted ROM path. tier is an honest RK3568 performance rating: great | good | playable | limited | experimental.",
  "systems": [
    {"id": "3ds", "name": "Nintendo 3DS", "short": "3DS", "folders": ["3ds", "n3ds"], "extensions": [".3ds", ".cci", ".cxi", ".app", ".3dsx", ".elf", ".axf"], "tier": "limited", "color": "#D12228",
     "note": "2D / light 3D titles only. Uses Azahar with 1x resolution and the Turbo profile. Big 3D games will run below full speed on the RK3568.",
     "commands": ["start_azahar.sh {rom}", "azahar {rom}", "start_lime3ds.sh {rom}", "lime3ds {rom}", "start_citra.sh {rom}", "citra {rom}", "ra:citra"]},
    {"id": "gc", "name": "Nintendo GameCube", "short": "GC", "folders": ["gamecube", "gc", "ngc"], "extensions": [".iso", ".gcm", ".gcz", ".rvz", ".ciso", ".dol"], "tier": "experimental", "color": "#6A5ACD",
     "note": "A handful of lighter games are playable with frame skip. Most titles run well below full speed on this chip.",
     "commands": ["start_dolphin_gc.sh {rom}", "start_dolphin.sh {rom}", "dolphin-emu-nogui -e {rom}", "ra:dolphin"]},
    {"id": "ps2", "name": "PlayStation 2", "short": "PS2", "folders": ["ps2"], "extensions": [".iso", ".chd", ".cso", ".bin", ".gz"], "tier": "experimental", "color": "#2E5BD8",
     "note": "Needs an ARM64 PS2 emulator to be installed by you (none ships with the base firmware for RK3568). Expect only very light 2D titles to approach full speed.",
     "commands": ["start_aethersx2.sh {rom}", "aethersx2 -fullscreen {rom}", "start_pcsx2.sh {rom}", "pcsx2-qt -fullscreen {rom}"]},
    {"id": "nds", "name": "Nintendo DS", "short": "NDS", "folders": ["nds"], "extensions": [".nds", ".zip", ".7z"], "tier": "good", "color": "#9AA3AD",
     "note": "Native dual-screen output. DraStic is fastest; melonDS is more accurate.",
     "commands": ["start_drastic.sh {rom}", "drastic {rom}", "ra:melondsds", "ra:melonds", "ra:desmume2015"]},
    {"id": "psp", "name": "PlayStation Portable", "short": "PSP", "folders": ["psp"], "extensions": [".iso", ".cso", ".pbp", ".chd"], "tier": "playable", "color": "#3A3A3A",
     "note": "Many games full speed at 1x resolution.",
